# Public hostname only, without https://
TERRACOTTA_DOMAIN=terracotta.example.com

# GitHub OAuth app:
# Homepage URL: https://terracotta.example.com
# Callback URL: https://terracotta.example.com/oauth2/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Comma-separated GitHub usernames that may sign in.
TERRACOTTA_GITHUB_USERS=hyunaeee

# Generate with:
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
HIGGSFIELD_MCP_CONNECTED=false
TERRACOTTA_MONTHLY_BUDGET_USD=24
MCP_TOKEN_ENCRYPTION_KEY=
TERRACOTTA_VERSION=latest
